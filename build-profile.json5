/*
 * ⚠️ 本文件刻意不含 signingConfigs。
 *
 * 签名材料（.cer / .p7b / .p12 与密码）属于个人身份，绝不能进仓库。
 * DevEco Studio 会在 File → Project Structure → Signing Configs 勾选
 * "Automatically generate signature" 后，把 signingConfigs 段写回本文件——
 * 那是**仅本机可见的本地改动**，请不要提交。
 *
 * 本机开发者建议执行一次，让 git 忽略此后 DevEco 写入的签名段：
 *     git update-index --skip-worktree build-profile.json5
 * 需要恢复跟踪时：
 *     git update-index --no-skip-worktree build-profile.json5
 *
 * 没有 signingConfigs 时 hvigorw 仍能产出**未签名** hap；装机前需在
 * DevEco 里生成签名，或自行用 sign 工具补签。
 */
{
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
